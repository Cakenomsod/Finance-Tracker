# Firebase Client Config
NEXT_PUBLIC_FIREBASE_API_KEY=your_api_key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your_project_id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your_project_id.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
NEXT_PUBLIC_FIREBASE_APP_ID=your_app_id

# Firebase Admin Config (Optional for server-side verification)
# To use Firebase Admin, you need to provide a service account.
# It's recommended to store it as a base64 encoded string in production.
# FIREBASE_ADMIN_PROJECT_ID=your_project_id
# FIREBASE_ADMIN_CLIENT_EMAIL=your_client_email
# FIREBASE_ADMIN_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Google AI / Gemini (receipt images + optional text chat)
# รองรับทั้งชื่อมาตรฐานของ Google AI Studio / Cloud และชื่อที่ใช้กันทั่วไป
GOOGLE_AI_API_KEY=your_google_ai_api_key
# GEMINI_API_KEY=your_alternate_key_name
# Gemini Flash (Google AI) — ใช้สำหรับอัปรูปใบเสร็จ
# หมายเหตุ: gemini-2.5-flash / gemini-2.0-flash มักได้ 404 สำหรับ API key ใหม่ — ใช้ 3.x
AI_RECEIPT_MODEL=gemini-3.6-flash
# Optional: ข้อความซับซ้อน (defaults to AI_RECEIPT_MODEL)
# AI_CHAT_MODEL=gemini-3.6-flash

# Local AI (LM Studio / Ollama via OpenAI-compatible API)
# LOCAL_AI_TIMEOUT_MS=180000
# LOCAL_AI_MODEL=google/gemma-4-e2b


IMMICH_API_KEY=

# Cron auth for POST /api/ai/insights/cron (GitHub Actions + manual curl)
# Must match the CRON_SECRET repo secret used by .github/workflows/ai-insights-cron.yml
# CRON_SECRET=generate_a_long_random_string
